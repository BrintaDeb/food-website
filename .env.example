# =================================================================
# CurryCraft — Production Environment Variables for Vercel
# =================================================================

# Canonical application URL (e.g. https://your-project.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret key (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=curry-craft-indian-gourmet-secret-key-production-32-chars

# Master Chef Kitchen Admin credentials
ADMIN_EMAIL=admin@currycraft.com
ADMIN_PASSWORD=Admin@12345
